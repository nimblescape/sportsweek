@startuml database-erd
!define PK <b><color:#b8860b><&key></color></b>
!define FK <color:#4682b4><&link></color>

hide circle
skinparam linetype ortho

entity "User" as user {
  PK id : string  ' Entra ID UPN (US-1)
  --
  firstName : string
  lastName : string
  email : string
  accountType : enum(teacher, student)  ' what they are: auto-assigned from the UPN domain at
                                        ' creation, granted by nobody, never client-writable (US-3)
  permissions : string[]  ' what they may do: a set, not a rank, granted through the rights page
                          ' by a holder of editUsers. Empty for every student, and for a teacher
                          ' until granted — the school's first teacher excepted (US-2, US-30)
}

entity "EventSeries" as eventSeries {
  PK id : string
  --
  name : string
  nameKey : string  ' the normalised name (trimmed, case-folded), derived by the server and never
                    ' sent by a client. Uniqueness is an equality query on this inside the write's
                    ' own transaction — an equality on name would compare exact strings and lose
                    ' the case- and whitespace-insensitivity the rule asks for (US-4, US-21)
  isOpenToStudents : boolean  ' whether students may join this series and go on amending what
                              ' they said. Any number may be open at once; an invitation link
                              ' sets it, archiving clears it, unarchiving does not restore it
                              ' (US-19, US-23)
  isArchived : boolean  ' archived event series are hidden from the teacher's list (US-19);
                        ' this is the only persisted archive flag — Registration's
                        ' archived state is computed via its eventSeriesId, never stored redundantly
  hasRegistrations : boolean  ' mirrors "a Registration record exists for this event series", so the
                              ' client can enable/disable archive and delete without reading a
                              ' collection it may not read; the server re-checks and decides (US-4)
  position : number  ' teacher-defined order, not alphabetical (see Ordering)
  --
  ' The seven teacher-maintained lists, in the order the master data menu shows them (US-14),
  ' with the events at the head because they are reached through this event series rather than
  ' through the menu. They are fields of this document rather than collections of their own, so a
  ' Kulturwoche is not made to share its lists with a Wintersportwoche (US-21). An item is a name:
  ' array order is the teacher-defined order, so none carries a position, and a name is its
  ' identity within its own list, so none carries an id. Uniqueness is decided in the write that
  ' changes the list, because the whole list is present in it — no reservation document is needed,
  ' and two event series may each hold a "Montafon" without either ever looking at the other.
  events : string[]  ' the weeks of this event series, assigned to in US-12
  classOptions : string[]  ' Klasse (US-6)
  programs : { name, requiredEquipment[] }[]  ' the one list whose entries are not bare names,
                                              ' because a program carries the equipment it
                                              ' requires (US-5): e.g. ski, ski boots, poles,
                                              ' helmet. Unique within their own program, so two
                                              ' programs may each require a helmet. The whole
                                              ' list is rewritten in one step, so adding,
                                              ' renaming and removing are atomic.
  skillLevels : string[]  ' Einsteiger:in, Anfänger:in, Fortgeschritten, Profi (US-7) — ranked,
                          ' so alphabetical would be wrong
  seasonPassOptions : string[]  ' Keine, Vielleicht, Golm-Bielerhöhe (Illwerke), … (US-10)
  busPickupPoints : string[]  ' typically ordered along the bus route (US-8)
  foodOptions : string[]  ' Alles, Vegetarisch, Vegan, Kein Schweinefleisch (US-9). The fixed
                          ' "other" option is not an entry here — it is offered alongside a
                          ' non-empty list and cannot be edited or removed; see
                          ' Registration.foodOtherText
  --
  ' Displayed state is derived, not stored: active (isActive), archived (isArchived),
  ' or inactive (neither). An event series with no registrations can be deleted in any state but
  ' cannot be archived; one with registrations must be archived before it can be deleted.
  ' Deleting takes its lists with it, since they are fields of this document, and cascades to
  ' all Registration records for that event series (US-4).
  ' An empty list is a question the student is never asked, which is what lets one application
  ' serve a Kulturwoche as well as a Wintersportwoche (US-21).
}

entity "Registration" as registration {
  PK id : string
  FK userId : string
  FK eventSeriesId : string  ' genuine FK — the only real reference among the "selected value" fields (US-11)
  --
  isIncomplete : boolean  ' whether answers are still outstanding (US-11); recomputed by the server
                          ' on every save and never sent by the client. Denormalised so the report
                          ' can mark those students without re-deriving it per row (US-13); the
                          ' student's own view never shows it
  isAttendingSportsWeek : boolean  ' "Are you attending the sports week?"; all fields below
                                   ' are shown/required only if this is true (US-11),
                                   ' EXCEPT .class, which is always shown/required regardless
  --
  ' The fields below are plain-text/enum snapshots of a teacher-maintained list value at
  ' selection time (US-11) — NOT foreign keys. The lists they are chosen from are fields of the
  ' event series this registration belongs to (US-21).
  class : string             ' copied from EventSeries.classOptions; always shown/required, not gated by isAttendingSportsWeek
  program : string           ' copied from an EventSeries.programs entry's name
  skillLevel : string        ' copied from EventSeries.skillLevels
  busPickupPoint : string    ' copied from EventSeries.busPickupPoints
  foodOption : string        ' copied from EventSeries.foodOptions, or "other"
  foodOtherText : string <<nullable>>   ' set when foodOption = "other"
  seasonPassOption : string  ' copied from EventSeries.seasonPassOptions
  --
  event : string <<nullable>>  ' assignment result (US-12); null = unassigned. Copied from
                               ' EventSeries.events by name, like every other list value — an
                               ' array entry has no id to point at (US-21)
  --
  dateOfBirth : date
  gender : enum(male, female)
  phoneNumber : string  ' international format, e.g. +43...
  emergencyContact : object <<nullable>>  ' firstName, lastName, relationship enum(mother, father,
                        ' other), relationshipOtherText <<nullable>>, phoneNumber (US-11); carried
                        ' on the record rather than in one of its own — a student has exactly one,
                        ' it has no identity outside this registration, and nothing refers to it
  healthNotes : text
  hasMedication : boolean
  equipmentRentalNeeded : boolean
  rentedEquipment : string[]  ' the entries of the selected program's requiredEquipment the student
                              ' rents (US-11), copied by name at selection time — not foreign keys.
                              ' A field for the same reason as the contact above, and rewritten
                              ' whole with the rest of the record, so a save is one atomic change.
  shoeSize : string <<nullable>>
  heightCm : number <<nullable>>
  weightKg : number <<nullable>>
}

entity "SavedReport" as savedReport {
  PK id : string
  FK createdByUserId : string  ' the teacher who saved it, for audit only \u2014 the report itself
                               ' is shared/visible to all teachers, not private (US-13)
  --
  name : string
  ' The report as it stood, stored in the shape the page works in rather than in a second
  ' spelling of it: which students are shown, and which detail lines they show (US-13).
  ' OR within a category, AND across categories, an empty array = no restriction (US-12, US-13).
  filter.name : string
  filter.tags.class : string[]
  filter.tags.gender : enum(male, female)[]
  filter.tags.program : string[]
  filter.tags.skillLevel : string[]
  ' The three below are US-13 only — the assignment dialog has no use for any of them: its
  ' cards are already one per event, and it lists only the students who are attending (US-12).
  filter.tags.attendance : enum(attending, notAttending)[]
  filter.tags.event : string[]
  filter.tags.completeness : enum(complete, incomplete)[]
  ' The activated field tags of the fields tag list, by key — a key nothing offers any more
  ' simply adds no detail line, so a report saved by an older release still opens (US-13).
  fields : string[]
}

' Event series (US-4)
eventSeries ||--o{ registration : "registered in (US-11)"

' Sports Week Master Data teacher-maintained lists (US-4 .. US-10)
' None of them is an entity any more: all seven, the events included, are ordered array fields
' of EventSeries (US-21), as are a program's requiredEquipment, Registration.emergencyContact
' and .rentedEquipment.

' The dotted line below is NOT a foreign key — it indicates that several Registration fields are
' plain-text copies of a list entry's name at the time it was selected (US-11): .event, .class,
' .program, .skillLevel, .busPickupPoint, .seasonPassOption, .foodOption, and .rentedEquipment
' from the chosen program's own requiredEquipment. Removing an event unassigns its students and
' renaming one rewrites what they hold (US-12).
eventSeries       .down.> registration : "list values copied by name"

' Student edits own registration (US-11)
user              ||--o{ registration : "owns (student)"

' Teacher views student report (US-13)
user              ||--o{ savedReport : "saves (teacher)"

@enduml
