# Copy to .env and adjust. .env is gitignored, so nothing set there travels with the code.

# Sign-in implementation. Leave unset (or `entra`) to use the real Microsoft/Entra ID login.
#
# `fake` swaps it for a dialog that mints a session from a typed name and role, so the app
# can be tried out as several teachers and students without tenant accounts. It is an
# authentication bypass: anyone who can reach /api/auth/fake becomes anyone. A production
# build refuses it regardless of this value -- see src/lib/auth/auth-mode.ts.
AUTH_MODE=entra

# Only needed alongside AUTH_MODE=fake. Minting a custom token means signing a JWT, and the
# user credential from `gcloud auth application-default login` holds no signing key, so the
# Admin SDK signs through the IAM API instead and has to be told which account to sign as.
# Deployments discover this from the metadata server and must leave it unset.
#
# Grant yourself the right to sign as it once:
#   gcloud iam service-accounts add-iam-policy-binding \
#     firebase-adminsdk-fbsvc@htld-sportsweek.iam.gserviceaccount.com \
#     --member="user:YOUR_EMAIL" --role="roles/iam.serviceAccountTokenCreator"
# FIREBASE_SERVICE_ACCOUNT_ID=firebase-adminsdk-fbsvc@htld-sportsweek.iam.gserviceaccount.com
