# Mirrors .gitignore so the Prettier VS Code extension (which only reads
# .prettierignore) ignores the same paths as `prettier --write .` (which
# already respects .gitignore by default via the CLI).

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.certs/

# additional prettier-only ignores
public
