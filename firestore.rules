rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * `/users` is keyed by UPN (see provisionUser), not by the opaque Firebase uid, so every
     * identity check has to go through the token's e-mail. Lowercased to match the stored id.
     */
    function upn() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function recordRole() {
      return get(/databases/$(database)/documents/users/$(upn())).data.role;
    }

    /**
     * Hierarchical by construction: every student-level rule also admits isTeacher().
     * The claim is checked first so the common case costs no document read; it is missing on
     * the very first login, which is what the fallback covers (see resolveRole in guards.ts).
     */
    function isTeacher() {
      return upn() != ''
        && (request.auth.token.role == 'teacher'
          || (exists(/databases/$(database)/documents/users/$(upn())) && recordRole() == 'teacher'));
    }

    function isSelf(uid) {
      return upn() != '' && upn() == uid;
    }

    // Mirrors requiredText(120) in src/lib/schemas/common.ts — keep both in sync.
    function isName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    // Mirrors documentIdSchema in src/lib/schemas/common.ts.
    function isDocumentId(value) {
      return value is string && value.size() > 0 && value.size() <= 1500;
    }

    function hasExactly(data, fields) {
      return data.keys().hasOnly(fields) && data.keys().hasAll(fields);
    }

    // See .github/instructions/firestore-security-rules.instructions.md before adding collections below.
    match /users/{uid} {
      allow read: if isSelf(uid) || isTeacher();

      // Records are provisioned on first login by the Admin SDK, which bypasses these rules.
      allow create: if false;

      // `role` is assigned once from the UPN domain and is never client-writable, at any role (US-3).
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);

      allow delete: if false;
    }

    // Every teacher-maintained list shares the same `{ name }` shape (US-5 to US-10), so one
    // allowlisted wildcard keeps the six blocks from drifting apart. Any collection not named
    // here falls through to its own match block below, or is denied outright.
    match /{list}/{itemId} {
      allow read: if isSignedIn()
        && list in ['programs', 'classOptions', 'skillLevels', 'busPickupPoints', 'foodOptions', 'seasonPassOptions'];

      allow create, update: if isTeacher()
        && list in ['programs', 'classOptions', 'skillLevels', 'busPickupPoints', 'foodOptions', 'seasonPassOptions']
        && hasExactly(request.resource.data, ['name'])
        && isName(request.resource.data.name);

      allow delete: if isTeacher()
        && list in ['programs', 'classOptions', 'skillLevels', 'busPickupPoints', 'foodOptions', 'seasonPassOptions'];
    }

    match /seasons/{seasonId} {
      // Students read seasons because their master data is scoped to the active one (US-11).
      allow read: if isSignedIn();

      allow create, update: if isTeacher()
        && hasExactly(request.resource.data, ['name', 'isActive', 'isArchived'])
        && isName(request.resource.data.name)
        && request.resource.data.isActive is bool
        && request.resource.data.isArchived is bool;

      // Removal has to cascade to events and master data (US-4), so it runs through the
      // Admin SDK in a Route Handler, which bypasses these rules.
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if isSignedIn();

      allow create, update: if isTeacher()
        && hasExactly(request.resource.data, ['seasonId', 'name'])
        && isDocumentId(request.resource.data.seasonId)
        && isName(request.resource.data.name);

      // Removal has to unassign the students first (US-4), so it runs through the Admin SDK.
      allow delete: if false;
    }

    match /requiredEquipmentItems/{itemId} {
      allow read: if isSignedIn();

      allow create, update: if isTeacher()
        && hasExactly(request.resource.data, ['programId', 'name'])
        && isDocumentId(request.resource.data.programId)
        && isName(request.resource.data.name);

      allow delete: if isTeacher();
    }
  }
}
