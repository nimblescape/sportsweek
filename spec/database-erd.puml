@startuml database-erd
!define PK <b><color:#b8860b><&key></color></b>
!define FK <color:#4682b4><&link></color>

hide circle
skinparam linetype ortho

entity "User" as user {
  PK id : string  ' Entra ID UPN (US-1)
  --
  firstName : string
  lastName : string
  email : string
  role : enum(teacher, student)  ' auto-assigned from UPN domain at creation (US-3)
}

entity "Season" as season {
  PK id : string
  --
  name : string
  isActive : boolean  ' at most one season may be true at any point in time; activating one
                      ' clears the flag on the previously active season in the same
                      ' transaction, and deactivating leaves none active (US-4)
  isArchived : boolean  ' archived seasons are hidden from the teacher's list (US-4);
                        ' this is the only persisted archive flag — StudentMasterData's
                        ' archived state is computed via its seasonId, never stored redundantly
  hasStudentData : boolean  ' mirrors "a StudentMasterData record exists for this season", so the
                            ' client can enable/disable archive and delete without reading a
                            ' collection it may not read; the server re-checks and decides (US-4)
  position : number  ' teacher-defined order, not alphabetical (see Ordering)
  --
  ' Displayed state is derived, not stored: active (isActive), archived (isArchived),
  ' or inactive (neither). A season with no student data can be deleted in any state but
  ' cannot be archived; one with student data must be archived before it can be deleted.
  ' Deleting cascades to its events and to all StudentMasterData records for that season (US-4).
}

entity "Event" as event {
  PK id : string
  FK seasonId : string
  --
  name : string
  position : number  ' teacher-defined order within the season (see Ordering)
}

entity "Program" as program {
  PK id : string
  --
  name : string  ' e.g. Ski, Snowboard, Alternativ (US-5); only editable/removable if unused by a non-archived season's master data
  requiredEquipment : string[]  ' e.g. ski, ski boots, poles, helmet (US-5); stored on the program
                                ' itself rather than as records of their own — an item has no
                                ' identity outside the program and is referenced from nowhere.
                                ' Unique within the program, compared case- and space-insensitively;
                                ' two programs may each require a helmet. The whole list is
                                ' rewritten in one step, so adding/renaming/removing is atomic,
                                ' and the array order is the teacher-defined order (see Ordering).
  position : number  ' teacher-defined order, not alphabetical (see Ordering)
}

entity "ClassOption" as classOption {
  PK id : string
  --
  name : string  ' Klasse (US-6); only editable/removable if unused by a non-archived season's master data
  position : number  ' teacher-defined order (see Ordering)
}

entity "SkillLevel" as skillLevel {
  PK id : string
  --
  name : string  ' Absoluter Anfänger, Anfänger, Fortgeschritten, Profi (US-7)
  position : number  ' teacher-defined order — these are ranked, so alphabetical would be wrong
}

entity "BusPickupPoint" as busPickupPoint {
  PK id : string
  --
  name : string  ' US-8
  position : number  ' teacher-defined order, typically along the bus route (see Ordering)
}

entity "FoodOption" as foodOption {
  PK id : string
  --
  name : string  ' Alles, Vegetarisch, Vegan, Kein Schweinefleisch (US-9)
  position : number  ' teacher-defined order (see Ordering)
  ' note: the fixed "other" option is not a row here — it is always available
  ' and cannot be edited/removed; see StudentMasterData.foodOtherText
}

entity "SeasonPassOption" as seasonPassOption {
  PK id : string
  --
  name : string  ' Keine, Vielleicht, Golm-Bielerhöhe (Illwerke), Silvretta-Montafon (US-10)
  position : number  ' teacher-defined order (see Ordering)
}

entity "StudentMasterData" as studentMasterData {
  PK id : string
  FK userId : string
  FK seasonId : string  ' genuine FK — the only real reference among the "selected value" fields (US-11)
  --
  isAttendingSportsWeek : boolean  ' "Are you attending the sports week?"; all fields below
                                   ' are shown/required only if this is true (US-11),
                                   ' EXCEPT .class, which is always shown/required regardless
  --
  ' The fields below are plain-text/enum snapshots of a teacher-maintained list value at
  ' selection time (US-11) — NOT foreign keys. Later edits/removals in the source list do
  ' not alter already-stored records.
  class : string             ' copied from ClassOption.name; always shown/required, not gated by isAttendingSportsWeek
  program : string           ' copied from Program.name
  skillLevel : string        ' copied from SkillLevel.name
  busPickupPoint : string    ' copied from BusPickupPoint.name
  foodOption : string        ' copied from FoodOption.name, or "other"
  foodOtherText : string <<nullable>>   ' set when foodOption = "other"
  seasonPassOption : string  ' copied from SeasonPassOption.name
  --
  FK eventId : string <<nullable>>  ' assignment result (US-12); null = unassigned
  --
  dateOfBirth : date
  gender : enum(male, female)
  phoneNumber : string  ' international format, e.g. +43...
  healthNotes : text
  hasMedication : boolean
  equipmentRentalNeeded : boolean
  shoeSize : string <<nullable>>
  heightCm : number <<nullable>>
  weightKg : number <<nullable>>
}

entity "EmergencyContact" as emergencyContact {
  PK id : string
  FK studentMasterDataId : string
  --
  firstName : string
  lastName : string
  relationship : enum(mother, father, other)
  relationshipOtherText : string <<nullable>>
  phoneNumber : string  ' international format, e.g. +43...
}

entity "EquipmentRentalItem" as equipmentRentalItem {
  PK id : string
  FK studentMasterDataId : string
  --
  itemName : string  ' copied from a Program.requiredEquipment entry at selection time, not a foreign key
}

entity "SavedReportFilter" as savedReportFilter {
  PK id : string
  FK createdByUserId : string  ' the teacher who saved it, for audit only \u2014 the filter itself
                               ' is shared/visible to all teachers, not private (US-13)
  --
  name : string
  ' Each *Filter field below is a set of selected tags for that category: OR within the field
  ' (a student matches if it matches any selected tag), AND across fields, empty/null = no
  ' restriction from that category (US-12, US-13)
  classFilter : string[] <<nullable>>
  genderFilter : enum(male, female)[] <<nullable>>
  programFilter : string[] <<nullable>>
  skillLevelFilter : string[] <<nullable>>
  attendingFilter : boolean[] <<nullable>>  ' US-13 only \u2014 no equivalent in the assignment dialog (US-12)
  nameTextFilter : string <<nullable>>
}

' Seasons & Events (US-4)
season ||--o{ event : "contains"
season ||--o{ studentMasterData : "registered in (US-11)"
event  |o--o{ studentMasterData : "assigned to (US-12); removing an event unassigns its students"

' Sports Week Master Data teacher-maintained lists (US-5 .. US-10)
' Program.requiredEquipment is an attribute, not an entity — there is no relationship to draw.

' The dotted lines below are NOT foreign keys — they indicate that a StudentMasterData
' field is a plain-text copy of a list item's name at the time it was selected (US-11).
program           .down.> studentMasterData : "value copied to .program"
classOption       .down.> studentMasterData : "value copied to .class"
skillLevel        .down.> studentMasterData : "value copied to .skillLevel"
busPickupPoint    .down.> studentMasterData : "value copied to .busPickupPoint"
seasonPassOption  .down.> studentMasterData : "value copied to .seasonPassOption"
foodOption        .down.> studentMasterData : "value copied to .foodOption"
program           .down.> equipmentRentalItem : "a .requiredEquipment entry is copied to .itemName"

' Student edits own master data (US-11)
user              ||--o{ studentMasterData : "owns (student)"
studentMasterData ||--|| emergencyContact : "has"
studentMasterData ||--o{ equipmentRentalItem : "requests"

' Teacher views student report (US-13)
user              ||--o{ savedReportFilter : "saves (teacher)"

@enduml
