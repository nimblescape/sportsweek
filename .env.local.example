# Copy to .env.local and fill in with values from the Firebase Console (Project settings > General).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Entra ID (Microsoft) tenant used by OAuthProvider("microsoft.com") — configure the provider itself
# in Firebase Console > Authentication > Sign-in method > Microsoft.
NEXT_PUBLIC_ENTRA_ID_TENANT_ID=

# No service account key — run `gcloud auth application-default login` once for local dev.
